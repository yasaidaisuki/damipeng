---
import Comments from '@/components/Comments.astro';
import { pages } from '@/data/site';
import Base from '@/layouts/Base.astro';
import { formatDate, isoDate } from '@/lib/format';
import { postTopic, readingMinutes, type Post } from '@/lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, date, draft } = post.data;
const topic = postTopic(post);
---

<Base
  title={title}
  description={summary}
  type="article"
  publishedTime={date}
  image={`/og/writing/${post.id}.png`}
  noindex={draft}
  width="post"
>
  <article class="pt-20 pb-12">
    <a href="/writing" class="min-h-touch text-muted inline-flex items-center text-sm">
      {pages.writing.backLink}
    </a>
    <p class="text-meta text-muted mt-4 flex flex-wrap gap-3 font-mono">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      {topic && <span>{topic}</span>}
      <span>{pages.writing.readingTime(readingMinutes(post))}</span>
      {draft && <span>Draft</span>}
    </p>
    <h1 class="text-h1-post mt-3">{title}</h1>
    <div class="prose-site mt-9">
      <slot />
    </div>
  </article>
  <Comments slug={post.id} draft={draft} copy={pages.comments} />
</Base>
