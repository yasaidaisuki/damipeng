---
import Comments from '@/components/islands/Comments';
import TagList from '@/components/TagList.astro';
import { pages } from '@/data/site';
import Base from '@/layouts/Base.astro';
import { formatDate, isoDate } from '@/lib/format';
import type { Post } from '@/lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, date, tags, draft } = post.data;
---

<Base
  title={title}
  description={summary}
  type="article"
  publishedTime={date}
  image={`/og/writing/${post.id}.png`}
  noindex={draft}
  width="post"
>
  <article class="pt-12">
    <a
      href="/writing"
      class="min-h-touch text-muted hover:text-fg -ml-1 inline-flex items-center px-1 font-mono text-sm no-underline"
    >
      {pages.writing.backLink}
    </a>
    <header class="mt-6 mb-10">
      <p class="section-label">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {draft && <span> · Draft</span>}
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl">{title}</h1>
      <p class="text-muted mt-3 text-lg">{summary}</p>
      <TagList tags={tags} label="Topics" />
    </header>
    <div class="prose-site">
      <slot />
    </div>
  </article>
  <Comments
    client:visible
    slug={post.id}
    heading={pages.comments.heading}
    placeholder={pages.comments.placeholder}
  />
</Base>
