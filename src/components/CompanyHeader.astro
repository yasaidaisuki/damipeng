---
import type { WorkEntry } from '@/data/work';
import { resolveLogo } from '@/lib/logos';

interface Props {
  entry: WorkEntry;
  /** Badge text shown next to the name for incoming roles. */
  badge?: string | undefined;
}

const { entry, badge } = Astro.props;
const { company } = entry;
const logo = resolveLogo(entry.logo);
---

<div class="flex flex-wrap items-center gap-3">
  {logo ? (
    <h2 class="flex max-w-full min-w-0 items-center">
      <span class="block max-w-full overflow-hidden" style={{ width: `${logo.boxWidth}px` }}>
        <img
          src={logo.src}
          alt={company}
          width={logo.width}
          height={logo.height}
          class="block h-auto max-w-none"
          style={logo.imgStyle}
          decoding="async"
        />
      </span>
    </h2>
  ) : (
    <h2 class="flex h-10 items-center text-2xl">{company}</h2>
  )}
  {badge && (
    <span class="border-accent text-accent rounded-full border px-2 py-[3px] font-mono text-xs">
      {badge}
    </span>
  )}
</div>
