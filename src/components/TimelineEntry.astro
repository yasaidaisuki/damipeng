---
import CompanyHeader from '@/components/CompanyHeader.astro';
import TagList from '@/components/TagList.astro';
import type { WorkEntry } from '@/data/work';

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
---

<li class="section grid gap-x-10 gap-y-4 sm:grid-cols-[10rem_1fr]">
  <div class="text-muted flex flex-col gap-1 font-mono text-sm sm:pt-5">
    <p>{entry.dates}</p>
    <p>{entry.location}</p>
  </div>
  <article aria-label={entry.company} class="min-w-0">
    <CompanyHeader entry={entry} />
    <p class="text-fg mt-3 font-medium">{entry.role}</p>
    {entry.note && <p class="text-muted mt-2 text-sm">{entry.note}</p>}
    {entry.bullets.length > 0 && (
      <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed">
        {entry.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )}
    <TagList tags={entry.tags} />
    {entry.terms.map((term) => (
      <section class="border-hairline mt-8 border-l pl-5">
        <h3 class="text-fg text-base">{term.label}</h3>
        <p class="text-muted mt-1 font-mono text-sm">{term.dates}</p>
        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed">
          {term.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
        <TagList tags={term.tags} />
      </section>
    ))}
  </article>
</li>
