---
import CompanyHeader from '@/components/CompanyHeader.astro';
import TagList from '@/components/TagList.astro';
import { pages } from '@/data/site';
import type { WorkEntry } from '@/data/work';

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const location =
  entry.terms.length > 1
    ? `${entry.location} · ${pages.work.terms(entry.terms.length)}`
    : entry.location;
const bulletList = 'text-body flex list-disc flex-col gap-2 pl-[18px] leading-[1.55]';
---

<li class="border-hairline flex flex-wrap gap-6 border-t py-10">
  <p class="text-meta text-muted flex-[0_0_var(--spacing-date-col)] font-mono leading-[1.6]">
    {entry.dates}
    <br />
    {location}
  </p>
  <article aria-label={entry.company} class="min-w-0 flex-[999_1_420px]">
    <CompanyHeader
      entry={entry}
      badge={entry.status === 'incoming' ? pages.work.incoming : undefined}
    />
    <p class="font-plex-mono text-muted mt-2 text-sm">{entry.role}</p>
    {entry.terms.map((term) => (
      <section>
        <h3 class="section-label mt-7 mb-2.5 text-xs">{term.label}</h3>
        <ul class={bulletList}>
          {term.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      </section>
    ))}
    {entry.bullets.length > 0 && (
      <ul class:list={[bulletList, 'mt-5']}>
        {entry.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )}
    <TagList tags={entry.tags} />
  </article>
</li>
