---
import type { Project } from '@/data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<li class="rounded-card border-hairline hover:border-border-strong relative flex flex-col border p-6 transition-colors">
  <h3 class="text-card-title">
    <!-- The title link stretches over the whole card; other links sit above it. -->
    <a href={project.href} class="text-fg after:absolute after:inset-0" {...external}>
      {project.name}
    </a>
  </h3>
  <p class="text-meta text-muted mt-1 font-mono">{project.stack.join(' · ')}</p>
  <p class="text-ui text-secondary mt-2.5 flex-1 leading-[1.55]">{project.summary}</p>
  {project.links && (
    <ul class="mt-3 flex flex-wrap gap-x-4">
      {project.links.map((link) => (
        <li>
          <a href={link.href} class="link-accent relative z-10 gap-1" {...external}>
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</li>
