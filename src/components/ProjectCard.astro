---
import TagList from '@/components/TagList.astro';
import type { Project } from '@/data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  <h3 class="text-lg">
    {project.href ? (
      <a href={project.href} class="text-fg hover:text-accent underline decoration-hairline">
        {project.name}
      </a>
    ) : (
      project.name
    )}
  </h3>
  <p class="mt-1">{project.summary}</p>
  <ul class="text-body mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed">
    {project.bullets.map((bullet) => (
      <li>{bullet}</li>
    ))}
  </ul>
  <TagList tags={project.stack} label="Tech stack" />
</article>
