---
import type { Project } from '@/data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const Tag = project.href ? 'a' : 'div';
---

<Tag href={project.href} class="rounded-card border-hairline text-fg block border p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-card-title">{project.name}</h3>
    <p class="text-meta text-muted font-mono">{project.stack.join(' · ')}</p>
  </div>
  <p class="text-ui text-secondary mt-2.5 leading-[1.55]">{project.summary}</p>
</Tag>
