---
import type { ImpactMetric } from '@/data/site';

interface Props {
  metric: ImpactMetric;
}

const { metric } = Astro.props;
---

<li class="card flex flex-col gap-2">
  <p class="text-fg text-3xl font-semibold tracking-tight tabular-nums">{metric.value}</p>
  <p class="section-label">{metric.label}</p>
  <p class="text-muted text-sm leading-relaxed">{metric.detail}</p>
</li>
