---
import type { ImpactMetric } from '@/data/site';

interface Props {
  metric: ImpactMetric;
}

const { metric } = Astro.props;
---

<li class="rounded-card border-hairline border p-5">
  <p class="text-metric text-accent font-semibold tabular-nums">{metric.value}</p>
  <p class="text-secondary mt-2 text-sm leading-normal">{metric.detail}</p>
</li>
