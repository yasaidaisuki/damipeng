---
import { links, pages, site } from '@/data/site';
---

<footer class="border-hairline text-meta text-muted flex flex-wrap items-center justify-between gap-3 border-t pt-8 pb-14 font-mono">
  <p>{site.meta}</p>
  <ul class="flex flex-wrap gap-x-5">
    <li>
      <a href="/rss.xml" class="text-muted">
        {pages.footer.rss}
      </a>
    </li>
    <li>
      <a href={links.email.href} class="text-muted">
        {site.email}
      </a>
    </li>
  </ul>
</footer>
