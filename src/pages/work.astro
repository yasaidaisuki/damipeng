---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import TimelineEntry from '@/components/TimelineEntry.astro';
import { links, pages } from '@/data/site';
import { work } from '@/data/work';
import Base from '@/layouts/Base.astro';

const page = pages.work;
---

<Base title={page.title} description={page.description} image="/og/work.png">
  <header class="page-header">
    <h1 class="text-h1">{page.heading}</h1>
    <p class="page-intro">{page.intro}</p>
    <a href={links.resume.href} class="link-accent mt-4" target="_blank" rel="noopener noreferrer">
      {page.resumeLink}
    </a>
  </header>
  <ol>
    {work.map((entry) => (
      <TimelineEntry entry={entry} />
    ))}
  </ol>
</Base>
