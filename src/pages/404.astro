---
import { pages } from '@/data/site';
import Base from '@/layouts/Base.astro';

const page = pages.notFound;
---

<Base title={page.title} description={page.description} noindex>
  <section class="page-header pb-24">
    <p class="section-label">404</p>
    <h1 class="text-h1 mt-3">{page.heading}</h1>
    <p class="page-intro">{page.body}</p>
    <a href="/" class="btn btn-secondary mt-8">
      {page.back}
    </a>
  </section>
</Base>
