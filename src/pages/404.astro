---
import { pages } from '@/data/site';
import Base from '@/layouts/Base.astro';

const page = pages.notFound;
---

<Base title={page.title} description={page.description} noindex>
  <section class="pt-24">
    <p class="section-label">404</p>
    <h1 class="mt-3 text-4xl">{page.heading}</h1>
    <p class="text-muted mt-3 text-lg">{page.body}</p>
    <a href="/" class="btn btn-secondary mt-8">
      {page.back}
    </a>
  </section>
</Base>
