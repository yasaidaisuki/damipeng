---
import MetricCard from '@/components/MetricCard.astro';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/inter/latin-600.css';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import StatusLine from '@/components/StatusLine.astro';
import { home, links, projects, site } from '@/data/site';
import Base from '@/layouts/Base.astro';
import { formatDate, isoDate } from '@/lib/format';
import { getPosts, postUrl } from '@/lib/posts';

const latest = (await getPosts()).slice(0, 3);
const secondaryCtas = [links.github, links.linkedin, { ...links.resume, label: home.ctas.resume }];
---

<Base>
  <section class="pt-30 pb-18" aria-labelledby="hero-heading">
    <div class="mb-5">
      <StatusLine />
    </div>
    <h1 id="hero-heading" class="text-display">
      {site.name}
    </h1>
    <p class="text-pitch text-secondary mt-5 max-w-[600px]">{home.pitch}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/work" class="btn btn-primary">
        {home.ctas.work}
      </a>
      {secondaryCtas.map((link) => (
        <a
          href={link.href}
          class="btn btn-secondary"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </section>

  <section class="section grid gap-8 sm:grid-cols-2" aria-label="Now and next">
    {home.nowNext.map((item) => (
      <div>
        <h2 class="section-label mb-2 text-xs">{item.label}</h2>
        <p class="text-body-lg leading-normal">
          {item.before}
          <a
            href={item.orgHref}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'text-fg font-semibold duration-300',
              item.orgBrand === 'ibm' && 'font-brand-ibm hover:text-brand-ibm',
              item.orgBrand === 'shopify' && 'font-brand-shopify hover:text-brand-shopify',
            ]}
          >
            {item.org}
          </a>
          {item.after}
        </p>
      </div>
    ))}
  </section>

  <section class="section" aria-labelledby="about">
    <SectionLabel id="about">{home.sections.about}</SectionLabel>
    <div class="text-body-lg text-body flex flex-col gap-4">
      {home.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="impact">
    <SectionLabel id="impact" class="mb-6">
      {home.sections.impact}
    </SectionLabel>
    <ul class="grid gap-4 sm:grid-cols-3">
      {home.impact.map((metric) => (
        <MetricCard metric={metric} />
      ))}
    </ul>
    <a href="/work" class="link-accent mt-3">
      {home.impactLink}
    </a>
  </section>

  <section class="section" aria-labelledby="projects">
    <SectionLabel id="projects">{home.sections.projects}</SectionLabel>
    <ul class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="writing">
    <div class="mb-2 flex items-baseline justify-between gap-4">
      <SectionLabel id="writing" class="">
        {home.sections.writing}
      </SectionLabel>
      <a href="/writing" class="text-accent hover:text-accent py-3 text-sm hover:opacity-80">
        {home.writingAll}
      </a>
    </div>
    {latest.length === 0 ? (
      <p class="text-muted py-4">{home.writingEmpty}</p>
    ) : (
      <ul>
        {latest.map((post) => (
          <li class="border-hairline-soft border-b last:border-b-0">
            <a
              href={postUrl(post)}
              class="text-body-lg flex flex-wrap justify-between gap-2 py-4 leading-normal"
            >
              <span>{post.data.title}</span>
              <time datetime={isoDate(post.data.date)} class="text-meta text-muted font-mono">
                {formatDate(post.data.date)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
