---
import MetricCard from '@/components/MetricCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import StatusLine from '@/components/StatusLine.astro';
import { home, links, projects, site } from '@/data/site';
import Base from '@/layouts/Base.astro';
import { formatDate, isoDate } from '@/lib/format';
import { getPosts, postUrl } from '@/lib/posts';

const latest = (await getPosts()).slice(0, 3);
const secondaryCtas = [links.github, links.linkedin, links.resume];
---

<Base>
  <section class="pt-16 pb-section sm:pt-24" aria-labelledby="hero-heading">
    <StatusLine />
    <h1 id="hero-heading" class="mt-6 text-4xl sm:text-5xl">
      {site.name}
    </h1>
    <p class="mt-4 max-w-[36rem] text-lg leading-relaxed sm:text-xl">{home.pitch}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/work" class="btn btn-primary">
        {home.ctas.work}
      </a>
      {secondaryCtas.map((link) => (
        <a
          href={link.href}
          class="btn btn-secondary"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="now-next">
    <SectionLabel id="now-next">{home.sections.nowNext}</SectionLabel>
    <div class="grid gap-8 sm:grid-cols-2">
      {home.nowNext.map((item) => (
        <div>
          <p class="text-accent font-mono text-sm">{item.label}</p>
          <h3 class="mt-2 text-lg">{item.title}</h3>
          <p class="text-muted mt-1 font-mono text-sm">{item.period}</p>
          <p class="mt-3 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="about">
    <SectionLabel id="about">{home.sections.about}</SectionLabel>
    <div class="space-y-4 text-lg leading-relaxed">
      {home.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="impact">
    <SectionLabel id="impact">{home.sections.impact}</SectionLabel>
    <ul class="grid gap-4 sm:grid-cols-3">
      {home.impact.map((metric) => (
        <MetricCard metric={metric} />
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="projects">
    <SectionLabel id="projects">{home.sections.projects}</SectionLabel>
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </section>

  <section class="section" aria-labelledby="writing">
    <div class="flex items-baseline justify-between gap-4">
      <SectionLabel id="writing">{home.sections.writing}</SectionLabel>
      <a
        href="/writing"
        class="text-muted hover:text-fg min-h-touch -mt-4 inline-flex items-center font-mono text-sm no-underline"
      >
        {home.writingAll}
      </a>
    </div>
    {latest.length === 0 ? (
      <p class="text-muted">{home.writingEmpty}</p>
    ) : (
      <ul class="divide-hairline divide-y">
        {latest.map((post) => (
          <li class="py-4 first:pt-0">
            <a
              href={postUrl(post)}
              class="group flex flex-col gap-1 no-underline sm:flex-row sm:gap-6"
            >
              <time
                datetime={isoDate(post.data.date)}
                class="text-muted shrink-0 font-mono text-sm sm:w-28"
              >
                {formatDate(post.data.date)}
              </time>
              <span class="text-fg group-hover:text-accent font-medium">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
