---
import StatusLine from '@/components/StatusLine.astro';
import { links, pages } from '@/data/site';
import Base from '@/layouts/Base.astro';

const page = pages.contact;
const rows = [links.email, links.linkedin, links.github, links.resume];
---

<Base title={page.title} description={page.description} image="/og/contact.png">
  <header class="pt-16 pb-10">
    <h1 class="text-4xl">{page.heading}</h1>
    <p class="text-muted mt-3 text-lg">{page.intro}</p>
    <div class="mt-6">
      <StatusLine />
    </div>
  </header>
  <ul class="divide-hairline border-hairline divide-y border-y">
    {rows.map((row) => (
      <li>
        <a
          href={row.href}
          class="group min-h-touch flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-4 no-underline"
          {...(row.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="section-label">{row.label}</span>
          <span class="text-fg group-hover:text-accent font-mono text-sm break-all">
            {row.value} <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
