---
import { links, pages } from '@/data/site';
import Base from '@/layouts/Base.astro';

const page = pages.contact;
const rows = [links.email, links.linkedin, links.github, links.resume];
---

<Base title={page.title} description={page.description} image="/og/contact.png">
  <header class="page-header">
    <h1 class="text-h1">{page.heading}</h1>
    <p class="page-intro">{page.intro}</p>
  </header>
  <ul class="border-hairline border-t">
    {rows.map((row) => (
      <li>
        <a
          href={row.href}
          class="border-hairline text-fg flex min-h-18 flex-wrap items-center justify-between gap-3 border-b"
          {...(row.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="section-label">{row.label}</span>
          <span
            class:list={['text-xl font-medium break-all', row === links.email && 'text-accent']}
          >
            {row.value}
            {row.suffix && <span aria-hidden="true"> {row.suffix}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="text-meta text-muted mt-8 mb-24 font-mono">{page.note}</p>
</Base>
